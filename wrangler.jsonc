{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodebox-converter",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // Our own log lines (one per conversion, cache hit or refusal, never the source) are kept for
  // usage counts. Cloudflare's per-request invocation logs are off, so no IP addresses are stored.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // The system prompt is bundled as text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "kv_namespaces": [
    // Finished conversions, kept 30 days (namespace "converter-cache").
    { "binding": "CACHE", "id": "a1352895e26c465a95cb8ec61cb7096c" }
  ],
  "ratelimits": [
    // Conversions that reach the model, per client IP.
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "MODEL": "claude-haiku-5-5"
  }
  // Secrets (wrangler secret put, or .dev.vars locally):
  //   ANTHROPIC_API_KEY (op://NodeBox/NodeBox Converter/Anthropic/ANTHROPIC_API_KEY)
}
